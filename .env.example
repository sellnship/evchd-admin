# Copy to .env for local dev; set the same vars in the admin's Vercel project.

# Neon Postgres (articles + topics + activity + settings)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Vercel Blob store (hero images) — create a Blob store and attach to this project
BLOB_READ_WRITE_TOKEN=

# Admin login (single user) + cookie signing secret (any long random string)
ADMIN_EMAIL=dev@vdo.co
ADMIN_PASSWORD=
SESSION_SECRET=

# GitHub — fine-grained PAT scoped to the site repo only:
#   Contents: read/write (Site Pages editor commits to main)
#   Actions:  read/write (dispatch the blog draft workflow)
GITHUB_TOKEN=
GITHUB_REPO=sellnship/evchd
