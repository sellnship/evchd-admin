---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listDir } from '../../../lib/github';

// Walk src/content (two levels: section + optional hi/) via the GitHub API.
const SECTIONS = ['guides', 'news', 'compare', 'glossary'];
let files: { path: string; section: string; lang: string; name: string }[] = [];
let ghError = '';
try {
  for (const section of SECTIONS) {
    let entries: Awaited<ReturnType<typeof listDir>> = [];
    try {
      entries = await listDir(`src/content/${section}`);
    } catch { continue; /* section dir may be empty/missing */ }
    for (const e of entries) {
      if (e.type === 'file' && e.name.endsWith('.md')) {
        files.push({ path: e.path, section, lang: 'en', name: e.name });
      } else if (e.type === 'dir' && e.name === 'hi') {
        const hiEntries = await listDir(e.path);
        for (const h of hiEntries) {
          if (h.type === 'file' && h.name.endsWith('.md')) {
            files.push({ path: h.path, section, lang: 'hi', name: h.name });
          }
        }
      }
    }
  }
} catch (e: any) {
  ghError = e?.message ?? 'GitHub API error';
}
files.sort((a, b) => a.section.localeCompare(b.section) || a.name.localeCompare(b.name) || a.lang.localeCompare(b.lang));

const done = Astro.url.searchParams.get('committed');
---
<AdminLayout title="Site Pages" active="site-pages" sub="Existing markdown sections — edits commit to main and auto-rebuild the site">
  {done && <div class="alert alert-success py-2 small">Committed to <span class="mono">main</span> — Vercel is rebuilding the site.</div>}
  {ghError ? (
    <div class="alert alert-danger py-2 small">
      GitHub API not reachable: {ghError}. Check GITHUB_TOKEN / GITHUB_REPO in Settings.
    </div>
  ) : (
    <div class="card p-3">
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead><tr><th>File</th><th>Section</th><th>Lang</th><th class="text-end"></th></tr></thead>
          <tbody>
            {files.map((f) => (
              <tr>
                <td class="mono small">{f.name}</td>
                <td class="small">{f.section}</td>
                <td><span class={`badge lang-${f.lang}`}>{f.lang.toUpperCase()}</span></td>
                <td class="text-end">
                  <a class="btn btn-sm btn-outline-light-subtle" href={`/admin/site-pages/edit?path=${encodeURIComponent(f.path)}`}>Edit</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="small text-secondary mt-2">
        ⚠ These are the git-based sections (guides, news, compare, glossary). Commits go
        <b> straight to main</b> and deploy in ~1–2 min — no PR, so re-read your change before saving.
      </div>
    </div>
  )}
</AdminLayout>
