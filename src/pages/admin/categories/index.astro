---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCategoryRows, countArticlesInCategory } from '../../../lib/categories';

const categories = await getCategoryRows();
const counts = await Promise.all(categories.map((c) => countArticlesInCategory(c.name)));
const saved = Astro.url.searchParams.get('saved');
const deleted = Astro.url.searchParams.get('deleted');
const err = Astro.url.searchParams.get('err');
---
<AdminLayout title="Categories" active="categories" sub={`${categories.length} categor${categories.length === 1 ? 'y' : 'ies'} — used on the blog's category dropdown`}>
  {saved && <div class="alert alert-success py-2 small">Saved.</div>}
  {deleted && <div class="alert alert-success py-2 small">Deleted.</div>}
  {err && <div class="alert alert-danger py-2 small">Error: {decodeURIComponent(err)}</div>}

  <div class="row g-3">
    <div class="col-lg-7">
      <div class="card p-3">
        {categories.length === 0 ? (
          <p class="text-secondary small mb-0">No categories yet — add one on the right.</p>
        ) : (
          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead><tr><th>Name</th><th>Description</th><th>Articles</th><th></th></tr></thead>
              <tbody>
                {categories.map((c, i) => (
                  <tr>
                    <td class="fw-semibold">{c.name}</td>
                    <td class="small text-secondary">{c.description}</td>
                    <td class="small">{counts[i]}</td>
                    <td class="text-end">
                      <a class="btn btn-sm btn-outline-light-subtle" href={`/admin/categories/${c.id}`}>Edit</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card p-3">
        <h2 class="h6 fw-bold mb-3">＋ Add category</h2>
        <form method="post" action="/admin/api/categories/save">
          <div class="mb-2">
            <label class="form-label small">Name</label>
            <input class="form-control" name="name" required placeholder="e.g. Buying Guide" />
          </div>
          <div class="mb-2">
            <label class="form-label small">Description</label>
            <textarea class="form-control" name="description" rows="3" placeholder="Shown as a hint, not published on the site"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label small">Sort order</label>
            <input class="form-control" type="number" name="sort" value="100" style="max-width: 100px;" />
          </div>
          <button class="btn btn-accent w-100" type="submit">Add category</button>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>
