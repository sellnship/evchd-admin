---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCategory, countArticlesInCategory } from '../../../lib/categories';

const { id } = Astro.params;
const category = await getCategory(Number(id));
if (!category) return Astro.redirect('/admin/categories');
const articleCount = await countArticlesInCategory(category.name);
---
<AdminLayout title={`Edit: ${category.name}`} active="categories" sub={`/admin/categories/${category.id}`}>
  <div class="row g-3">
    <div class="col-lg-7">
      <div class="card p-3">
        <form method="post" action="/admin/api/categories/save">
          <input type="hidden" name="id" value={category.id} />
          <div class="mb-2">
            <label class="form-label small">Name</label>
            <input class="form-control" name="name" value={category.name} required />
            {articleCount > 0 && (
              <div class="small text-secondary mt-1">
                Renaming won't update the {articleCount} article{articleCount === 1 ? '' : 's'} already using
                "{category.name}" — they'd need to be re-saved with the new name.
              </div>
            )}
          </div>
          <div class="mb-2">
            <label class="form-label small">Description</label>
            <textarea class="form-control" name="description" rows="3">{category.description}</textarea>
          </div>
          <div class="mb-3">
            <label class="form-label small">Sort order</label>
            <input class="form-control" type="number" name="sort" value={category.sort} style="max-width: 100px;" />
          </div>
          <div class="d-flex gap-2">
            <button class="btn btn-accent" type="submit">💾 Save</button>
            <a class="btn btn-outline-light-subtle" href="/admin/categories">← Back</a>
          </div>
        </form>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card p-3">
        <h2 class="h6 fw-bold">Delete</h2>
        <p class="small text-secondary">
          {articleCount > 0 ? (
            <>{articleCount} article{articleCount === 1 ? '' : 's'} currently use <b>{category.name}</b> as plain
            text — deleting the category here won't touch them, it just removes it from the dropdown for new picks.</>
          ) : (
            <>No articles currently use this category.</>
          )}
        </p>
        <form method="post" action="/admin/api/categories/delete"
              onsubmit={`return confirm('Delete ${category.name.replace(/'/g, "\\'")}? This cannot be undone.')`}>
          <input type="hidden" name="id" value={category.id} />
          <button class="btn btn-outline-danger btn-sm" type="submit">Delete category</button>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>
