---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql, type Article } from '../../../lib/db';
import { getAvailableImageModels, getDefaultImageModel, getConfiguredProviders } from '../../../lib/llm';
import { getCategories } from '../../../lib/categories';
import { estimateImageCostUsd, estimateImageTimeSec, formatUsd, GPT_IMAGE_QUALITIES } from '../../../lib/apiCost';
import { getAuthors } from '../../../lib/authors';

const { id } = Astro.params;
const isNew = id === 'new';

let article: Partial<Article> = {
  slug: Astro.url.searchParams.get('slug') ?? '',
  lang: (Astro.url.searchParams.get('lang') as 'en' | 'hi') ?? 'en',
  title: '',
  description: '',
  category: '',
  hero_image: '',
  author: 'rajinder-singh',
  reviewed_by: 'rajinder-singh',
  tags: [],
  body_md: '',
  status: 'draft',
  source: 'manual',
};

if (!isNew) {
  const rows = (await sql()`SELECT * FROM articles WHERE id = ${Number(id)}`) as unknown as Article[];
  if (!rows.length) return Astro.redirect('/admin/blog');
  article = rows[0];
}

// EN↔HI pair: same slug, other lang. Looked up for isNew too (not just existing
// articles) so a freshly-created translation counterpart can default its hero
// image and offer the other language's in-body images for reuse -- images are
// the same real-world subject regardless of which language describes them, so
// there's no reason to regenerate/re-upload them per language.
let counterpart: Article | null = null;
if (article.slug) {
  const other = article.lang === 'hi' ? 'en' : 'hi';
  const rows = (await sql()`SELECT * FROM articles WHERE slug = ${article.slug} AND lang = ${other}`) as unknown as Article[];
  counterpart = rows[0] ?? null;
}

// Hero: only offered as a *default* when this article doesn't already have its
// own -- never silently overrides a hero already picked for this language.
const inheritedHeroImage = !article.hero_image && counterpart?.hero_image ? counterpart.hero_image : '';

// In-body images already used in the counterpart's markdown, offered as
// one-click "reuse" inserts instead of generating a fresh AI image for the
// same scene in the other language.
const counterpartImages: { url: string; alt: string }[] = counterpart?.body_md
  ? [...counterpart.body_md.matchAll(/!\[([^\]]*)\]\((https?:\/\/[^\s)]+)\)/g)].map((m) => ({ alt: m[1], url: m[2] }))
  : [];

const saved = Astro.url.searchParams.get('saved');
const err = Astro.url.searchParams.get('err');

// AI image generation rides on the OpenAI / Gemini keys. Model list = only
// models whose provider is configured; default = Settings choice or best.
const imageModels = await getAvailableImageModels();
const imagesReady = imageModels.length > 0;
const defaultImageModel = await getDefaultImageModel();

// Estimated cost/time per model (+ per quality tier for gpt-image-1), keyed
// for the client-side JS below — "gpt-image-1:low" etc, else just the model id.
const imageEstimates: Record<string, { cost: string; time: number }> = {};
for (const m of imageModels) {
  if (m.id === 'gpt-image-1') {
    for (const q of GPT_IMAGE_QUALITIES) {
      imageEstimates[`gpt-image-1:${q}`] = { cost: formatUsd(estimateImageCostUsd(m.id, q)), time: estimateImageTimeSec(m.id, q) };
    }
  } else {
    imageEstimates[m.id] = { cost: formatUsd(estimateImageCostUsd(m.id)), time: estimateImageTimeSec(m.id) };
  }
}

// Default image prompt "according to the article", editable before generating:
// prefer the queued topic's image scene, else derive one from title/category.
let defaultScene = '';
if (!isNew && article.slug) {
  const t = (await sql()`
    SELECT image_prompt FROM topics
    WHERE slug = ${article.slug} AND lang = ${article.lang}`) as { image_prompt: string }[];
  defaultScene = t[0]?.image_prompt?.trim() || '';
  if (!defaultScene) {
    defaultScene =
      `An everyday ${article.category || 'EV'} scene in Chandigarh/Mohali that illustrates ` +
      `"${article.title}" — real people, residential sectors, natural light.`;
  }
}

// Category dropdown from the DB; keep a legacy value selectable if the article
// has one that's no longer in the categories table.
const categories = await getCategories();
if (article.category && !categories.includes(article.category)) categories.unshift(article.category);

const authors = await getAuthors();
const llmReady = (await getConfiguredProviders()).length > 0;

// Pipeline audit trail (populated only by the AI pipeline, admin/blog/ai.astro -- a manually
// created/edited article simply has these null). Advisory only: matches the same "flag, don't
// block" gate the pipeline UI itself uses, since this page is also the one place a manual edit
// with no pipeline data at all still needs to publish freely.
const editorialReview = article.editorial_review_json as { verdict: 'PASS' | 'FAIL'; blockers: string[] } | null | undefined;
const factCheck = article.fact_check_json as { blockers?: { problem: string }[] } | null | undefined;
const editorialGateFails = editorialReview?.verdict === 'FAIL' || Boolean(factCheck?.blockers?.length);
const hasPipelineReport = Boolean(
  article.research_json || article.fact_check_json || article.seo_report_json ||
  article.editorial_review_json || article.ai_pattern_check_json || article.similarity_json,
);
---
<AdminLayout title={isNew ? 'New Article' : `Edit: ${article.title}`} active="blog" sub={isNew ? 'Create a blog article' : `/${article.slug} (${article.lang})`}>
  {saved && <div class="alert alert-success py-2 small">Saved.</div>}
  {err && <div class="alert alert-danger py-2 small">Error: {decodeURIComponent(err)}</div>}

  <form method="post" action="/admin/api/blog/save" enctype="multipart/form-data">
    <input type="hidden" name="id" value={isNew ? '' : String(article.id)} />
    <input type="hidden" name="fact_check_json" id="factCheckJsonInput" />
    <input type="hidden" name="seo_report_json" id="seoReportJsonInput" />
    <div class="row g-3">
      <div class="col-lg-8">
        <div class="card p-3 mb-3">
          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label small">Title</label>
              <input class="form-control" name="title" value={article.title} required />
            </div>
            <div class="col-md-4">
              <label class="form-label small">Category</label>
              <select class="form-select" name="category">
                <option value="" disabled selected={!article.category}>— Select category —</option>
                {categories.map((c) => <option value={c} selected={c === article.category}>{c}</option>)}
              </select>
            </div>
            <div class="col-md-8">
              <label class="form-label small">Slug</label>
              <input class="form-control mono" name="slug" value={article.slug} pattern="[a-z0-9-]+" required readonly={!isNew} />
            </div>
            <div class="col-md-4">
              <label class="form-label small">Language</label>
              <select class="form-select" name="lang" disabled={!isNew}>
                <option value="en" selected={article.lang === 'en'}>English</option>
                <option value="hi" selected={article.lang === 'hi'}>Hindi</option>
              </select>
              {!isNew && <input type="hidden" name="lang" value={article.lang} />}
            </div>
            <div class="col-12">
              <label class="form-label small">Description (meta, ≤158 chars)</label>
              <textarea class="form-control" name="description" rows="2" maxlength="200">{article.description}</textarea>
            </div>
            <div class="col-12">
              <label class="form-label small">Tags (comma-separated)</label>
              <input class="form-control" name="tags" value={(article.tags ?? []).join(', ')} />
            </div>
            <div class="col-md-6">
              <label class="form-label small">Author <a href="/admin/authors" class="small text-secondary ms-1">(manage)</a></label>
              <select class="form-select" name="author">
                {authors.map((a) => <option value={a.id} selected={a.id === article.author}>{a.name}</option>)}
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small">Reviewed by</label>
              <select class="form-select" name="reviewed_by">
                {authors.map((a) => <option value={a.id} selected={a.id === article.reviewed_by}>{a.name}</option>)}
              </select>
            </div>
          </div>
        </div>

        <div class="card p-3">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
            <label class="form-label small fw-bold mb-0">Body (Markdown) <span id="bodyWordCount" class="text-secondary fw-normal"></span></label>
            <div class="d-flex align-items-center gap-1">
              <label class="small text-secondary mb-0">Target length</label>
              <select class="form-select form-select-sm w-auto" id="targetLength">
                <option value="700">Short (~700-900w)</option>
                <option value="900" selected>Medium (~900-1300w)</option>
                <option value="1600">Long (~1600-2200w)</option>
              </select>
              <span id="lengthStatus" class="small"></span>
            </div>
          </div>
          <textarea class="form-control body-editor" name="body_md" id="bodyEditor">{article.body_md}</textarea>

          <div class="border-top border-secondary-subtle pt-2 mt-2">
            {llmReady && (
              <div class="d-flex align-items-center gap-2 mb-2">
                <label class="small text-secondary mb-0">Focus keyword <span class="text-secondary">(optional, for SEO Check)</span></label>
                <input class="form-control form-control-sm w-auto" id="focusKeywordInput" style="max-width: 260px;"
                       placeholder="e.g. electric scooter hacking" />
              </div>
            )}
            <div class="d-flex gap-2 flex-wrap">
              <button type="button" class="btn btn-outline-light-subtle btn-sm" id="previewBtn">👁 Preview</button>
              {llmReady ? (
                <>
                  <button type="button" class="btn btn-outline-light-subtle btn-sm" id="factCheckBtn">✓ Fact Check</button>
                  <button type="button" class="btn btn-outline-light-subtle btn-sm" id="seoCheckBtn">🔎 SEO Check</button>
                  <button type="button" class="btn btn-outline-light-subtle btn-sm" id="internalLinksBtn">🔗 Add Internal Links</button>
                  <button type="button" class="btn btn-warning btn-sm d-none" id="expandBtn">📏 Expand Article</button>
                  {counterpart?.body_md && (
                    <button type="button" class="btn btn-outline-light-subtle btn-sm" id="translateBtn">
                      🌐 Translate from {counterpart.lang === 'hi' ? 'Hindi' : 'English'} version
                    </button>
                  )}
                </>
              ) : (
                <span class="small text-secondary align-self-center">Fact-check &amp; SEO check need an LLM key — <a href="/admin/settings">add one in Settings</a>.</span>
              )}
            </div>
            <div class="progress mt-2 d-none" style="height: 6px;" id="toolsProgressWrap">
              <div class="progress-bar" id="toolsProgressBar" role="progressbar" style="width: 0%"></div>
            </div>
            <div class="small mt-1" id="contentToolsStatus"></div>
            <div class="mt-2" id="factCheckResults" style="display:none;"></div>
            <div class="mt-2" id="seoCheckResults" style="display:none;"></div>
            <div class="small mt-2" id="linksSkippedBox" style="display:none;"></div>
          </div>

          {counterpartImages.length > 0 && (
            <div class="border-top border-secondary-subtle pt-2 mt-2">
              <label class="form-label small fw-bold mb-1">
                🔁 Reuse images from the {counterpart!.lang === 'hi' ? 'Hindi' : 'English'} version
              </label>
              <div class="d-flex flex-wrap gap-2">
                {counterpartImages.map((img, i) => (
                  <button type="button" class="btn btn-outline-light-subtle btn-sm p-1" data-reuse-image={i} title={img.alt}>
                    <img src={img.url} alt={img.alt} style="width: 64px; height: 36px; object-fit: cover; display: block;" />
                  </button>
                ))}
              </div>
              <div class="small text-secondary mt-1">Click to insert the same image at your cursor -- no need to regenerate it for this language.</div>
            </div>
          )}

          {!isNew && imagesReady && (
            <div class="border-top border-secondary-subtle pt-2 mt-2">
              <label class="form-label small fw-bold mb-1">🖼 Insert AI image at cursor</label>
              <div class="d-flex gap-2">
                <input class="form-control form-control-sm" id="bodyImgPrompt"
                       placeholder="Describe the scene for this in-article image" />
                <select class="form-select form-select-sm w-auto" id="bodyImgModel">
                  {imageModels.map((m) => (
                    <option value={m.id} selected={m.id === defaultImageModel}>{m.label}</option>
                  ))}
                </select>
                <select class="form-select form-select-sm w-auto" id="bodyImgQuality">
                  {GPT_IMAGE_QUALITIES.map((q) => (
                    <option value={q} selected={q === 'medium'}>{q}</option>
                  ))}
                </select>
                <button class="btn btn-outline-light-subtle btn-sm flex-shrink-0" type="button" id="bodyImgBtn">Generate &amp; Insert</button>
              </div>
              <div class="small text-secondary mt-1" id="bodyImgEstimate"></div>
              <div class="progress mt-1 d-none" style="height: 6px;" id="bodyImgProgressWrap">
                <div class="progress-bar" id="bodyImgProgressBar" role="progressbar" style="width: 0%"></div>
              </div>
              <div class="small text-secondary mt-1" id="bodyImgStatus">Generates 16:9 (no watermark), uploads, and inserts the markdown where your cursor is.</div>
            </div>
          )}
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card p-3 mb-3">
          <h2 class="h6 fw-bold">Status</h2>
          <p class="small mb-2">
            Current: <span class={`badge status-${article.status}`}>{article.status}</span>
            {article.source === 'ai' && <span class="badge lang-en ms-1">AI draft</span>}
          </p>
          {editorialGateFails && (
            <div class="alert alert-warning py-2 small mb-2">
              This article's AI pipeline flagged issue(s) before publishing — see Pipeline Report below.
            </div>
          )}
          <button class="btn btn-accent w-100 mb-2" type="submit" name="action" value="save">💾 Save</button>
          {!isNew && article.status === 'draft' && (
            <button class="btn btn-success w-100 mb-2" type="submit" name="action" value="publish"
              onclick={`return confirm(${editorialGateFails ? "'This article has flagged issues (see Pipeline Report) — publish anyway?'" : "'Publish this article and rebuild the website?'"})`}>🚀 Save &amp; Publish</button>
          )}
          {!isNew && article.status === 'published' && (
            <button class="btn btn-outline-light-subtle w-100 mb-2" type="submit" name="action" value="unpublish"
              onclick="return confirm('Unpublish? The article will disappear from the site on next rebuild.')">Unpublish</button>
          )}
          <div class="small text-secondary">Publishing flips the status and fires the Vercel deploy hook — live in ~1–2 min.</div>
        </div>

        <div class="card p-3 mb-3">
          <h2 class="h6 fw-bold">Hero image</h2>
          <div id="heroImageBox">
            {article.hero_image ? (
              <img class="hero-thumb mb-2" src={article.hero_image} alt="hero" />
            ) : inheritedHeroImage ? (
              <>
                <img class="hero-thumb mb-1" src={inheritedHeroImage} alt="hero" />
                <p class="small text-secondary mb-2">
                  Using the {counterpart!.lang === 'hi' ? 'Hindi' : 'English'} version's hero by default —
                  💾 Save to confirm, or generate/upload a different one below first.
                </p>
              </>
            ) : (
              <p class="small text-secondary mb-2">No hero yet.</p>
            )}
          </div>
          <input type="hidden" name="inherited_hero_image" value={inheritedHeroImage} />
          <label class="form-label small mb-1">Upload your own</label>
          <input class="form-control form-control-sm" type="file" name="hero" accept="image/*" />
          <div class="small text-secondary mt-1 mb-2">Resized to 1200×675 WebP on Vercel Blob (saved with 💾 Save).</div>

          <label class="form-label small mb-1">Alt text <span class="text-secondary fw-normal">(accessibility &amp; SEO)</span></label>
          <input class="form-control form-control-sm mb-2" id="heroAltInput" name="image_alt" value={article.image_alt ?? ''}
                 placeholder="Describe what's actually in the image, e.g. a rider charging a low-speed scooter in a Chandigarh sector" />
          <div class="small text-secondary mt-1 mb-2">Falls back to the article title on the live site if left blank.</div>

          <div class="border-top border-secondary-subtle pt-2">
            <label class="form-label small fw-bold mb-1">🎨 Generate with AI</label>
            {isNew ? (
              <div class="small text-secondary">💾 Save the article once, then generate a hero here.</div>
            ) : !imagesReady ? (
              <div class="alert alert-warning py-2 small mb-0">
                Image generation needs an <b>OpenAI</b> or <b>Gemini</b> key —
                <a href="/admin/settings">add one in Settings</a>.
              </div>
            ) : (
              <>
                <textarea class="form-control form-control-sm mb-2" id="heroPrompt" rows="3" required
                  placeholder="Describe the SCENE (vehicle & style rules are added automatically)">{defaultScene}</textarea>
                <div class="row g-2 mb-2">
                  <div class="col-8">
                    <label class="form-label small mb-1">Image model</label>
                    <select class="form-select form-select-sm" id="heroModel">
                      {imageModels.map((m) => (
                        <option value={m.id} selected={m.id === defaultImageModel}>{m.label}</option>
                      ))}
                    </select>
                  </div>
                  <div class="col-4">
                    <label class="form-label small mb-1">Quality</label>
                    <select class="form-select form-select-sm" id="heroQuality">
                      {GPT_IMAGE_QUALITIES.map((q) => (
                        <option value={q} selected={q === 'medium'}>{q}</option>
                      ))}
                    </select>
                  </div>
                </div>
                <div class="small text-secondary mb-2" id="heroEstimate"></div>
                <button class="btn btn-accent btn-sm w-100" type="button" id="heroGenBtn">🎨 Generate Hero</button>
                <div class="progress mt-2 d-none" style="height: 6px;" id="heroProgressWrap">
                  <div class="progress-bar" id="heroProgressBar" role="progressbar" style="width: 0%"></div>
                </div>
                <div class="small text-secondary mt-1" id="heroStatus">Generates 16:9, brands it (1200×675 + logo), saves to this article.</div>
              </>
            )}
          </div>
        </div>

        {!isNew && hasPipelineReport && (
          <div class="card p-3 mb-3">
            <h2 class="h6 fw-bold">Pipeline Report</h2>
            <div class="small">
              {article.duplicate_check_json && (
                <div class="mb-1"><b>Duplicate check:</b> {(article.duplicate_check_json as any).verdict}</div>
              )}
              {factCheck && (
                <div class="mb-1"><b>Fact check:</b> {(article.fact_check_json as any).issues?.length ?? 0} issue(s), {factCheck.blockers?.length ?? 0} critical</div>
              )}
              {article.similarity_json && (
                <div class="mb-1"><b>Similarity:</b> {(article.similarity_json as any).status}</div>
              )}
              {article.ai_pattern_check_json && (
                <div class="mb-1"><b>AI-pattern score:</b> {(article.ai_pattern_check_json as any).score}/100</div>
              )}
              {article.seo_report_json && (
                <div class="mb-1"><b>SEO score:</b> {(article.seo_report_json as any).score ?? '—'}</div>
              )}
              {editorialReview && (
                <div class="mb-1">
                  <b>Editorial gate:</b> <span class={`badge ${editorialReview.verdict === 'PASS' ? 'status-published' : 'status-pending'}`}>{editorialReview.verdict}</span>
                  {editorialReview.blockers?.length > 0 && (
                    <ul class="mb-0 mt-1">
                      {editorialReview.blockers.map((b) => <li>{b}</li>)}
                    </ul>
                  )}
                </div>
              )}
            </div>
          </div>
        )}

        {!isNew && (
          <div class="card p-3">
            <h2 class="h6 fw-bold">Translation pair</h2>
            {counterpart ? (
              <a class="btn btn-outline-light-subtle btn-sm w-100" href={`/admin/blog/${counterpart.id}`}>
                Edit {article.lang === 'hi' ? 'English' : 'Hindi'} version
              </a>
            ) : (
              <a class="btn btn-outline-light-subtle btn-sm w-100"
                 href={`/admin/blog/new?slug=${article.slug}&lang=${article.lang === 'hi' ? 'en' : 'hi'}`}>
                ＋ Create {article.lang === 'hi' ? 'English' : 'Hindi'} counterpart
              </a>
            )}
            <div class="small text-secondary mt-2">EN &amp; HI share the slug — that's the language-toggle link on the site.</div>
          </div>
        )}
      </div>
    </div>
  </form>

  <div id="previewOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:1050; align-items:center; justify-content:center;">
    <div style="background:var(--bs-body-bg); max-width:800px; width:92%; max-height:85vh; overflow:auto; border-radius:8px; padding:1.5rem;">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="fw-bold mb-0">Article Preview</p>
        <button type="button" class="btn-close" id="previewCloseBtn"></button>
      </div>
      <div id="previewContent"></div>
    </div>
  </div>

  <script define:vars={{ counterpartTitle: counterpart?.title ?? '', counterpartDescription: counterpart?.description ?? '', counterpartBody: counterpart?.body_md ?? '', targetLang: article.lang }}>
    // Live word count + target-length guidance on the Body textarea — matches
    // the AI Generator page's counter, but this page never had one (manual
    // edits and continuing an AI draft here both need to see it against the
    // 700-word minimum, not just during the initial AI Generator run).
    const bodyEditorEl = document.getElementById('bodyEditor');

    // Reuse-from-other-language images: insert the same image markdown at the
    // cursor rather than regenerating a fresh AI image for the same scene.
    document.querySelectorAll('[data-reuse-image]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const img = btn.querySelector('img');
        const md = `\n\n![${img.alt.replace(/[[\]]/g, '')}](${img.src})\n\n`;
        const pos = bodyEditorEl.selectionStart ?? bodyEditorEl.value.length;
        bodyEditorEl.value = bodyEditorEl.value.slice(0, pos) + md + bodyEditorEl.value.slice(pos);
        bodyEditorEl.focus();
        bodyEditorEl.setSelectionRange(pos + md.length, pos + md.length);
        updateBodyWordCount();
      });
    });

    const bodyWordCountEl = document.getElementById('bodyWordCount');
    const targetLengthEl = document.getElementById('targetLength');
    const lengthStatusEl = document.getElementById('lengthStatus');
    const LENGTH_RANGES = { '700': [700, 900], '900': [900, 1300], '1600': [1600, 2200] };

    function wordCount(text) {
      return text.trim() ? text.trim().split(/\s+/).length : 0;
    }
    function updateBodyWordCount() {
      const words = wordCount(bodyEditorEl.value);
      bodyWordCountEl.textContent = `(${words} word${words === 1 ? '' : 's'})`;
      const [min, max] = LENGTH_RANGES[targetLengthEl.value];
      if (words < 700) {
        lengthStatusEl.textContent = 'below the 700-word minimum';
        lengthStatusEl.style.color = '#F87171';
      } else if (words < min) {
        lengthStatusEl.textContent = `below target (${min}-${max}w)`;
        lengthStatusEl.style.color = '#F5A94E';
      } else if (words <= max) {
        lengthStatusEl.textContent = 'within target ✓';
        lengthStatusEl.style.color = '#4ADE80';
      } else {
        lengthStatusEl.textContent = 'above target (fine, just longer)';
        lengthStatusEl.style.color = '';
      }
      const expandBtnEl = document.getElementById('expandBtn');
      if (expandBtnEl) expandBtnEl.classList.toggle('d-none', words >= min);
    }
    bodyEditorEl.addEventListener('input', updateBodyWordCount);
    targetLengthEl.addEventListener('change', updateBodyWordCount);
    updateBodyWordCount();

    async function safeJson(res) {
      const text = await res.text();
      try { return JSON.parse(text); } catch { throw new Error(`Server error (status ${res.status}): ${(text || 'empty response').slice(0, 200)}`); }
    }
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    const toolsStatusEl = document.getElementById('contentToolsStatus');
    function setToolsStatus(message, isError) {
      toolsStatusEl.textContent = message;
      toolsStatusEl.style.color = isError ? '#F87171' : '';
    }

    // Same fake-but-honest progress bar as the hero/body image generators
    // (blog/[id].astro doesn't always have the image tools' script loaded, so
    // this is a separate copy) -- fact-check/SEO-check are single LLM calls
    // with no incremental status to report, so this eases toward ~90% over a
    // rough estimate and completes when the request actually resolves.
    const toolsProgressBar = document.getElementById('toolsProgressBar');
    const toolsProgressWrap = document.getElementById('toolsProgressWrap');
    function startToolsProgress(estimateSec) {
      toolsProgressWrap.classList.remove('d-none');
      toolsProgressBar.style.width = '0%';
      const start = Date.now();
      const totalMs = Math.max(3000, estimateSec * 1000);
      const timer = setInterval(() => {
        toolsProgressBar.style.width = Math.min(90, (90 * (Date.now() - start)) / totalMs) + '%';
      }, 200);
      return () => {
        clearInterval(timer);
        toolsProgressBar.style.width = '100%';
        setTimeout(() => toolsProgressWrap.classList.add('d-none'), 400);
      };
    }

    // Jump the editor's cursor/selection to a piece of text (fact-check's
    // "claim" is the exact wording from the article, so this is a real
    // "where" -- not just a description of the problem).
    function findInBody(text) {
      if (!text) return false;
      const idx = bodyEditorEl.value.indexOf(text);
      if (idx === -1) return false;
      bodyEditorEl.focus();
      bodyEditorEl.setSelectionRange(idx, idx + text.length);
      return true;
    }

    function factCheckGuidance(issue) {
      return issue.severity === 'critical'
        ? 'Critical -- already corrected in the article body above. Re-read that section to make sure the fix reads naturally, then 💾 Save.'
        : 'Warning only -- not auto-fixed. Edit the claim above if you want to address it, or leave it if it\'s fine as written.';
    }
    function renderFactCheckResults(factCheck) {
      const box = document.getElementById('factCheckResults');
      if (!factCheck.issues.length) {
        box.style.display = '';
        box.innerHTML = '<div class="alert alert-success py-2 small mb-0">No factual issues found against the verified local facts/models data.</div>';
        return;
      }
      box.style.display = '';
      box.innerHTML = factCheck.issues.map((issue, i) => `
        <div class="card p-2 mb-2">
          <div class="d-flex justify-content-between align-items-start gap-2">
            <span class="badge ${issue.severity === 'critical' ? 'bg-danger' : 'bg-warning text-dark'}">${esc(issue.severity)}</span>
            ${issue.claim ? `<button type="button" class="btn btn-sm btn-outline-light-subtle flex-shrink-0" data-find-claim="${i}">📍 Find in article</button>` : ''}
          </div>
          ${issue.claim ? `<div class="small mt-1"><b>Claim:</b> "<span class="mono">${esc(issue.claim)}</span>"</div>` : ''}
          <div class="small mt-1"><b>Problem:</b> ${esc(issue.problem)}</div>
          <div class="small text-secondary mt-1">${esc(factCheckGuidance(issue))}</div>
        </div>`).join('');
      box.querySelectorAll('[data-find-claim]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const issue = factCheck.issues[Number(btn.dataset.findClaim)];
          if (!findInBody(issue.claim)) { btn.textContent = 'Not found verbatim (may have been rephrased)'; btn.disabled = true; }
        });
      });
    }

    function seoFlagGuidance(flag) {
      const f = flag.toLowerCase();
      if (f.includes('seo title')) return 'Fix: edit the Title field above (aim for 30-65 characters).';
      if (f.includes('meta description')) return 'Fix: edit the Description field above (aim for 110-165 characters) -- SEO Check already filled in a suggestion if one was missing.';
      if (f.includes('subheading')) return 'Fix: add a few ## or ### headings in the Body to break up the article.';
      if (f.includes('opening paragraph')) return 'Fix: mention the focus keyword in the article\'s first paragraph.';
      if (f.includes('internal link')) return 'Fix: add a markdown link to another EV Chandigarh page in the body -- SEO Check inserts these automatically when it finds a good match, or add one by hand.';
      if (f.includes('alt text')) return 'Fix: set alt text when generating/uploading the hero image.';
      if (f.includes('short')) return 'Fix: expand the article -- thin content ranks less reliably.';
      return 'Review and adjust the article body or the fields above.';
    }
    function renderSeoCheckResults(seoScore) {
      const box = document.getElementById('seoCheckResults');
      box.style.display = '';
      if (!seoScore?.flags?.length) {
        box.innerHTML = '<div class="alert alert-success py-2 small mb-0">No SEO issues found.</div>';
        return;
      }
      box.innerHTML = seoScore.flags.map((flag) => `
        <div class="card p-2 mb-2">
          <div class="small"><b>Issue:</b> ${esc(flag)}</div>
          <div class="small text-secondary mt-1">${esc(seoFlagGuidance(flag))}</div>
        </div>`).join('');
    }

    // Preview — same render endpoint as the AI Generator page, just fed from
    // this page's plain form fields instead of its own result pane.
    const previewOverlay = document.getElementById('previewOverlay');
    document.getElementById('previewBtn').addEventListener('click', async () => {
      const btn = document.getElementById('previewBtn');
      const original = btn.textContent;
      btn.disabled = true; btn.textContent = 'Loading…';
      try {
        const res = await fetch('/admin/api/blog/preview', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: document.querySelector('input[name="title"]').value,
            category: document.querySelector('select[name="category"]').value,
            tags: document.querySelector('input[name="tags"]').value.split(',').map((t) => t.trim()).filter(Boolean),
            contentMarkdown: bodyEditorEl.value,
            coverImageUrl: document.querySelector('#heroImageBox img')?.src || '',
          }),
        });
        const data = await safeJson(res);
        if (!res.ok) throw new Error(data.error || 'Could not render a preview.');
        document.getElementById('previewContent').innerHTML = data.html;
        previewOverlay.style.display = 'flex';
      } catch (err) {
        setToolsStatus(err.message, true);
      } finally { btn.disabled = false; btn.textContent = original; }
    });
    document.getElementById('previewCloseBtn').addEventListener('click', () => { previewOverlay.style.display = 'none'; });
    previewOverlay.addEventListener('click', (e) => { if (e.target === previewOverlay) previewOverlay.style.display = 'none'; });

    // Fact Check / SEO Check — reuse the AI pipeline's single-stage endpoints
    // against whatever's currently in the editor, so a manually-written
    // article gets the same checks an AI-generated one does. Results are
    // stashed into hidden fields and only actually persisted on the next
    // 💾 Save (so a check-then-abandon never writes anything).
    const factCheckBtn = document.getElementById('factCheckBtn');
    if (factCheckBtn) {
      factCheckBtn.addEventListener('click', async () => {
        const original = factCheckBtn.textContent;
        factCheckBtn.disabled = true; factCheckBtn.textContent = 'Checking…';
        setToolsStatus('Fact-checking against verified local facts/models data… (~15-20s)', false);
        document.getElementById('factCheckResults').style.display = 'none';
        const finishProgress = startToolsProgress(18);
        try {
          const res = await fetch('/admin/api/blog/factcheck-only', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contentMarkdown: bodyEditorEl.value }),
          });
          const data = await safeJson(res);
          if (!res.ok) throw new Error(data.error || 'Fact check failed.');
          bodyEditorEl.value = data.contentMarkdown;
          updateBodyWordCount();
          document.getElementById('factCheckJsonInput').value = JSON.stringify(data.factCheck);
          renderFactCheckResults(data.factCheck);
          setToolsStatus(
            `Fact check: ${data.factCheck.issues.length} issue(s), ${data.factCheck.blockers.length} critical blocker(s) — see details below. 💾 Save to keep this in the Pipeline Report.`,
            data.factCheck.blockers.length > 0,
          );
        } catch (err) {
          setToolsStatus(`Fact check failed: ${err.message} — try again, or check your LLM key in Settings.`, true);
        } finally {
          finishProgress();
          factCheckBtn.disabled = false; factCheckBtn.textContent = original;
        }
      });
    }
    const seoCheckBtn = document.getElementById('seoCheckBtn');
    if (seoCheckBtn) {
      seoCheckBtn.addEventListener('click', async () => {
        const original = seoCheckBtn.textContent;
        seoCheckBtn.disabled = true; seoCheckBtn.textContent = 'Checking…';
        setToolsStatus('Scoring SEO and looking for internal-link opportunities… (~15-20s)', false);
        document.getElementById('seoCheckResults').style.display = 'none';
        const finishProgress = startToolsProgress(18);
        try {
          const res = await fetch('/admin/api/blog/seo-optimize-only', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              title: document.querySelector('input[name="title"]').value.trim(),
              contentMarkdown: bodyEditorEl.value,
              category: document.querySelector('select[name="category"]').value,
              slug: document.querySelector('input[name="slug"]').value.trim(),
              lang: targetLang,
              focusKeyword: document.getElementById('focusKeywordInput')?.value.trim() || undefined,
            }),
          });
          const data = await safeJson(res);
          if (!res.ok) throw new Error(data.error || 'SEO check failed.');
          bodyEditorEl.value = data.contentMarkdown;
          updateBodyWordCount();
          if (data.seoTitle) document.querySelector('input[name="title"]').value = data.seoTitle;
          const descEl = document.querySelector('textarea[name="description"]');
          if (data.seoDescription) descEl.value = data.seoDescription;
          document.getElementById('seoReportJsonInput').value =
            JSON.stringify({ ...data.seoReport, score: data.seoScore?.score, flags: data.seoScore?.flags });
          renderSeoCheckResults(data.seoScore);
          const linksNote = data.internalLinksInserted?.length
            ? ` — ${data.internalLinksInserted.length} internal link(s) inserted`
            : '';
          setToolsStatus(
            `SEO score: ${data.seoScore?.score ?? '—'}/100${linksNote} — title/description updated above, see details below. 💾 Save to keep this in the Pipeline Report.`,
            (data.seoScore?.score ?? 100) < 70,
          );
        } catch (err) {
          setToolsStatus(`SEO check failed: ${err.message} — try again, or check your LLM key in Settings.`, true);
        } finally {
          finishProgress();
          seoCheckBtn.disabled = false; seoCheckBtn.textContent = original;
        }
      });
    }

    // Suggestions the auto-linker couldn't place verbatim (anchor text not found in the body) --
    // shown with a manual "Insert" action so a genuinely good suggestion isn't just silently
    // dropped. Inserts at the current cursor position, or the end if nothing is focused there.
    function renderLinksSkipped(skipped) {
      const box = document.getElementById('linksSkippedBox');
      if (!skipped || !skipped.length) { box.style.display = 'none'; box.innerHTML = ''; return; }
      box.style.display = '';
      box.innerHTML = '<div class="text-secondary mb-1">Suggested but not auto-inserted (anchor text not found verbatim):</div>' +
        skipped.map((s, i) => `
          <div class="d-flex align-items-center gap-2 mb-1">
            <span>[${esc(s.anchorText)}](${esc(s.url)})${s.reason ? ` — <span class="text-secondary">${esc(s.reason)}</span>` : ''}</span>
            <button type="button" class="btn btn-sm btn-outline-light-subtle flex-shrink-0" data-insert-link="${i}">Insert</button>
          </div>`).join('');
      box.querySelectorAll('[data-insert-link]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const s = skipped[Number(btn.dataset.insertLink)];
          const md = `[${s.anchorText}](${s.url})`;
          const pos = bodyEditorEl.selectionStart ?? bodyEditorEl.value.length;
          bodyEditorEl.value = bodyEditorEl.value.slice(0, pos) + md + bodyEditorEl.value.slice(pos);
          bodyEditorEl.focus();
          bodyEditorEl.setSelectionRange(pos + md.length, pos + md.length);
          updateBodyWordCount();
          btn.disabled = true;
          btn.textContent = 'Inserted';
        });
      });
    }

    const internalLinksBtn = document.getElementById('internalLinksBtn');
    if (internalLinksBtn) {
      internalLinksBtn.addEventListener('click', async () => {
        const original = internalLinksBtn.textContent;
        internalLinksBtn.disabled = true; internalLinksBtn.textContent = 'Linking…';
        setToolsStatus('Looking for good internal-link opportunities… (~15-20s)', false);
        document.getElementById('linksSkippedBox').style.display = 'none';
        const finishProgress = startToolsProgress(18);
        try {
          const res = await fetch('/admin/api/blog/internal-links-only', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contentMarkdown: bodyEditorEl.value,
              slug: document.querySelector('input[name="slug"]').value.trim(),
              lang: targetLang,
            }),
          });
          const data = await safeJson(res);
          if (!res.ok) throw new Error(data.error || 'Internal linking failed.');
          bodyEditorEl.value = data.contentMarkdown;
          updateBodyWordCount();
          renderLinksSkipped(data.internalLinksSkipped);
          setToolsStatus(
            data.note || `${data.internalLinksInserted.length} internal link(s) inserted${data.internalLinksSkipped?.length ? `, ${data.internalLinksSkipped.length} suggested but not found verbatim (see below)` : ''} — 💾 Save when happy.`,
            false,
          );
        } catch (err) {
          setToolsStatus(`Internal linking failed: ${err.message} — try again, or check your LLM key in Settings.`, true);
        } finally {
          finishProgress();
          internalLinksBtn.disabled = false; internalLinksBtn.textContent = original;
        }
      });
    }

    // Expand Article -- shown (see updateBodyWordCount above) only while the
    // body is under the selected target's minimum. Reuses the same
    // apply-instruction endpoint the AI Generator's free-form "Custom
    // instruction" box uses, rather than the AI pipeline's own expandArticle()
    // (which needs a research packet a manually-written article doesn't have)
    // -- a plain, explicit rewrite instruction works fine here.
    const expandBtn = document.getElementById('expandBtn');
    if (expandBtn) {
      expandBtn.addEventListener('click', async () => {
        const original = expandBtn.textContent;
        const words = wordCount(bodyEditorEl.value);
        const [min] = LENGTH_RANGES[targetLengthEl.value];
        expandBtn.disabled = true; expandBtn.textContent = 'Expanding…';
        setToolsStatus(`Expanding from ${words} toward ${min}+ words… (~20-25s)`, false);
        const finishProgress = startToolsProgress(22);
        try {
          const instruction =
            `Expand this article to at least ${min} words (currently about ${words}). Add more specific, ` +
            'sourced detail relevant to Chandigarh/Mohali/Panchkula low-speed EV scooters -- do not pad with ' +
            'filler, repetition, or speculation. Keep every existing fact/figure and the overall structure ' +
            'exactly as given; add real substance, not length for its own sake.';
          const res = await fetch('/admin/api/blog/apply-instruction', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              title: document.querySelector('input[name="title"]').value.trim(),
              contentMarkdown: bodyEditorEl.value,
              instruction,
            }),
          });
          const data = await safeJson(res);
          if (!res.ok) throw new Error(data.error || 'Expand failed.');
          bodyEditorEl.value = data.contentMarkdown;
          updateBodyWordCount();
          const newWords = wordCount(bodyEditorEl.value);
          setToolsStatus(
            `Expanded ${words} → ${newWords} words. Re-run Fact Check/SEO Check on the new material, then 💾 Save.`,
            newWords < min,
          );
        } catch (err) {
          setToolsStatus(`Expand failed: ${err.message} — try again, or check your LLM key in Settings.`, true);
        } finally {
          finishProgress();
          expandBtn.disabled = false; expandBtn.textContent = original;
        }
      });
    }

    // Translate from the other language's counterpart -- keeps EN/HI aligned in
    // structure/facts instead of letting two independently-drafted versions
    // diverge. Replaces this article's Title + Body, so confirm first.
    const translateBtn = document.getElementById('translateBtn');
    if (translateBtn) {
      translateBtn.addEventListener('click', async () => {
        const langLabel = targetLang === 'hi' ? 'Hindi' : 'English';
        if (!confirm(`Replace this article's Title, Description and Body with a fresh translation from the ${targetLang === 'hi' ? 'English' : 'Hindi'} version? This overwrites what's currently in the editor.`)) return;
        const original = translateBtn.textContent;
        translateBtn.disabled = true; translateBtn.textContent = 'Translating…';
        setToolsStatus(`Translating into ${langLabel}, keeping the same structure and facts… (~20-30s)`, false);
        const finishProgress = startToolsProgress(25);
        try {
          const res = await fetch('/admin/api/blog/translate-from-counterpart', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sourceTitle: counterpartTitle, sourceDescription: counterpartDescription, sourceMarkdown: counterpartBody, targetLang }),
          });
          const data = await safeJson(res);
          if (!res.ok) throw new Error(data.error || 'Translation failed.');
          document.querySelector('input[name="title"]').value = data.title;
          if (data.description) document.querySelector('textarea[name="description"]').value = data.description;
          bodyEditorEl.value = data.contentMarkdown;
          updateBodyWordCount();
          setToolsStatus(`Translated from the ${targetLang === 'hi' ? 'English' : 'Hindi'} version — review, then 💾 Save.`, false);
        } catch (err) {
          setToolsStatus(`Translation failed: ${err.message} — try again, or check your LLM key in Settings.`, true);
        } finally {
          finishProgress();
          translateBtn.disabled = false; translateBtn.textContent = original;
        }
      });
    }
  </script>

  {!isNew && imagesReady && (
    <script define:vars={{ articleId: article.id, imageEstimates }}>
      function estimateFor(model, quality) {
        const key = model === 'gpt-image-1' ? `gpt-image-1:${quality}` : model;
        return imageEstimates[key] || { cost: '~$0.04', time: 20 };
      }

      // Fake-but-honest progress: no incremental status is available from these
      // non-streaming image APIs, so this eases toward ~90% over the estimated
      // time and only jumps to 100% once the request actually resolves.
      function startProgress(barEl, wrapEl, estimateSec) {
        wrapEl.classList.remove('d-none');
        barEl.style.width = '0%';
        const start = Date.now();
        const totalMs = Math.max(3000, estimateSec * 1000);
        const timer = setInterval(() => {
          const pct = Math.min(90, (90 * (Date.now() - start)) / totalMs);
          barEl.style.width = pct + '%';
        }, 200);
        return () => {
          clearInterval(timer);
          barEl.style.width = '100%';
          setTimeout(() => wrapEl.classList.add('d-none'), 400);
        };
      }

      // ── Hero image ────────────────────────────────────────────────────────
      const heroBtn = document.getElementById('heroGenBtn');
      if (heroBtn) {
        const heroModelEl = document.getElementById('heroModel');
        const heroQualityEl = document.getElementById('heroQuality');
        const heroQualityWrap = heroQualityEl.closest('.col-4');
        const heroEstimateEl = document.getElementById('heroEstimate');
        const heroStatusEl = document.getElementById('heroStatus');
        const heroProgressBar = document.getElementById('heroProgressBar');
        const heroProgressWrap = document.getElementById('heroProgressWrap');

        function refreshHeroEstimate() {
          const isGpt = heroModelEl.value === 'gpt-image-1';
          heroQualityWrap.style.display = isGpt ? '' : 'none';
          const est = estimateFor(heroModelEl.value, heroQualityEl.value);
          let note = `Estimated cost: ${est.cost} · estimated time: ~${est.time}s`;
          if (isGpt && heroQualityEl.value === 'high') note += ' — close to this plan\'s 60s limit, may time out.';
          heroEstimateEl.textContent = note;
        }
        heroModelEl.addEventListener('change', refreshHeroEstimate);
        heroQualityEl.addEventListener('change', refreshHeroEstimate);
        refreshHeroEstimate();

        heroBtn.addEventListener('click', async () => {
          const prompt = document.getElementById('heroPrompt').value.trim();
          if (!prompt) { heroStatusEl.textContent = 'Describe the scene first.'; return; }
          const est = estimateFor(heroModelEl.value, heroQualityEl.value);
          heroBtn.disabled = true;
          heroStatusEl.textContent = `Generating… (~${est.time}s, ${est.cost})`;
          const finishProgress = startProgress(heroProgressBar, heroProgressWrap, est.time);
          try {
            const form = new FormData();
            form.set('id', String(articleId));
            form.set('image_prompt', prompt);
            form.set('image_model', heroModelEl.value);
            form.set('image_quality', heroQualityEl.value);
            const res = await fetch('/admin/api/blog/genhero', { method: 'POST', body: form });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'hero generation failed');
            document.getElementById('heroImageBox').innerHTML =
              `<img class="hero-thumb mb-2" src="${data.url}" alt="hero" />`;
            const heroAltInput = document.getElementById('heroAltInput');
            if (heroAltInput && !heroAltInput.value.trim()) heroAltInput.value = prompt;
            heroStatusEl.textContent = '✓ Hero generated and saved — Alt text suggested below, edit if needed.';
          } catch (e) {
            heroStatusEl.textContent = '✗ ' + e.message;
          } finally {
            finishProgress();
            heroBtn.disabled = false;
          }
        });
      }

      // ── In-body image ────────────────────────────────────────────────────
      const btn = document.getElementById('bodyImgBtn');
      const statusEl = document.getElementById('bodyImgStatus');
      const bodyModelEl = document.getElementById('bodyImgModel');
      const bodyQualityEl = document.getElementById('bodyImgQuality');
      const bodyEstimateEl = document.getElementById('bodyImgEstimate');
      const bodyProgressBar = document.getElementById('bodyImgProgressBar');
      const bodyProgressWrap = document.getElementById('bodyImgProgressWrap');

      function refreshBodyEstimate() {
        const isGpt = bodyModelEl.value === 'gpt-image-1';
        bodyQualityEl.style.display = isGpt ? '' : 'none';
        const est = estimateFor(bodyModelEl.value, bodyQualityEl.value);
        bodyEstimateEl.textContent = `Estimated cost: ${est.cost} · estimated time: ~${est.time}s`;
      }
      bodyModelEl?.addEventListener('change', refreshBodyEstimate);
      bodyQualityEl?.addEventListener('change', refreshBodyEstimate);
      refreshBodyEstimate();

      btn?.addEventListener('click', async () => {
        const editor = document.getElementById('bodyEditor');
        const prompt = document.getElementById('bodyImgPrompt').value.trim();
        const model = bodyModelEl.value;
        const quality = bodyQualityEl.value;
        if (!prompt) { statusEl.textContent = 'Describe the scene first.'; return; }
        const est = estimateFor(model, quality);
        btn.disabled = true;
        statusEl.textContent = `Generating… (~${est.time}s, ${est.cost})`;
        const finishProgress = startProgress(bodyProgressBar, bodyProgressWrap, est.time);
        try {
          const res = await fetch('/admin/api/blog/genimage', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id: articleId, prompt, image_model: model, image_quality: quality }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'generation failed');
          const md = `\n\n![${prompt.replace(/[\[\]]/g, '')}](${data.url})\n\n`;
          const pos = editor.selectionStart ?? editor.value.length;
          editor.value = editor.value.slice(0, pos) + md + editor.value.slice(pos);
          statusEl.textContent = '✓ Inserted — remember to 💾 Save.';
          document.getElementById('bodyImgPrompt').value = '';
        } catch (e) {
          statusEl.textContent = '✗ ' + e.message;
        } finally {
          finishProgress();
          btn.disabled = false;
        }
      });
    </script>
  )}
</AdminLayout>
