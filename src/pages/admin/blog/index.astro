---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql, type Article } from '../../../lib/db';

const flt = Astro.url.searchParams.get('status') ?? '';
const rows = (flt
  ? await sql()`SELECT * FROM articles WHERE status = ${flt} ORDER BY updated_at DESC`
  : await sql()`SELECT * FROM articles ORDER BY updated_at DESC`) as unknown as Article[];

const fmt = (d: string | null) =>
  d ? new Date(d).toLocaleDateString('en-IN', { dateStyle: 'medium' }) : '—';
---
<AdminLayout title="Blog CMS" active="blog" sub={`${rows.length} article(s)`}>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div class="btn-group">
      <a class={`btn btn-sm ${!flt ? 'btn-accent' : 'btn-outline-light-subtle'}`} href="/admin/blog">All</a>
      <a class={`btn btn-sm ${flt === 'published' ? 'btn-accent' : 'btn-outline-light-subtle'}`} href="/admin/blog?status=published">Published</a>
      <a class={`btn btn-sm ${flt === 'draft' ? 'btn-accent' : 'btn-outline-light-subtle'}`} href="/admin/blog?status=draft">Drafts</a>
    </div>
    <a class="btn btn-accent btn-sm" href="/admin/blog/new">＋ New Article</a>
  </div>

  <div class="card p-3">
    {rows.length === 0 ? (
      <p class="text-secondary small mb-0">No articles yet. Create one or run the AI Generator.</p>
    ) : (
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead><tr><th>Title</th><th>Lang</th><th>Category</th><th>Status</th><th>Source</th><th>Published</th><th></th></tr></thead>
          <tbody>
            {rows.map((a) => (
              <tr>
                <td>
                  <div class="fw-semibold">{a.title}</div>
                  <div class="mono text-secondary">/{a.slug}</div>
                </td>
                <td><span class={`badge lang-${a.lang}`}>{a.lang.toUpperCase()}</span></td>
                <td class="small">{a.category}</td>
                <td><span class={`badge status-${a.status}`}>{a.status}</span></td>
                <td class="small text-secondary">{a.source}</td>
                <td class="small text-secondary">{fmt(a.date_published)}</td>
                <td class="text-end">
                  <a class="btn btn-sm btn-outline-light-subtle" href={`/admin/blog/${a.id}`}>Edit</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>
