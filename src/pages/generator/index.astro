---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { sql, type Topic } from '../../lib/db';
import { actionsUrl } from '../../lib/github';
import { getActiveProvider, getConfiguredProviders } from '../../lib/llm';
import { getCategories } from '../../lib/categories';
import { env } from '../../lib/env';

const topics = (await sql()`
  SELECT t.*, a.id AS article_id
  FROM topics t
  LEFT JOIN articles a ON a.slug = t.slug AND a.lang = t.lang
  ORDER BY t.created_at DESC, t.lang`) as unknown as (Topic & { article_id: number | null })[];

const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
let ghUrl = '#';
try { ghUrl = actionsUrl(); } catch { /* GITHUB_REPO not configured yet */ }

// LLM dropdown: every provider with a key, best-ranked first; preselect the
// active one (which itself falls back to the best configured provider).
const configured = await getConfiguredProviders();
const activeProvider = await getActiveProvider();
const llmReady = configured.length > 0;
const categories = await getCategories();
const engineReady = Boolean(env('GITHUB_TOKEN')); // "▶ Engine" path needs the PAT
---
<AdminLayout title="AI Article Generator" active="generator" sub="Queue a topic → the engine drafts EN + HI with all quality gates">
  {ok && <div class="alert alert-success py-2 small">{decodeURIComponent(ok)}</div>}
  {err && <div class="alert alert-danger py-2 small">Error: {decodeURIComponent(err)}</div>}

  <div class="row g-3">
    <div class="col-lg-5">
      <div class="card p-3 mb-3">
        <h2 class="h6 fw-bold mb-2">⚙ New Topic (EN + HI pair)</h2>
        {llmReady ? (
          <div class="d-flex gap-2 align-items-center mb-2">
            <select class="form-select form-select-sm" id="f_provider" title="LLM used for Suggest & Draft">
              {configured.map((p) => (
                <option value={p.id} selected={p.id === activeProvider}>{p.label} — {p.model}</option>
              ))}
            </select>
            <button class="btn btn-sm btn-accent flex-shrink-0" type="button" id="suggestBtn">💡 Suggest Topics</button>
          </div>
        ) : (
          <div class="alert alert-warning py-2 small mb-2">
            No LLM key configured — <a href="/settings">add one in Settings</a> to enable AI features.
          </div>
        )}
        <div id="suggestStatus" class="small text-secondary d-none mb-2">
          Fetching trends &amp; asking the model… (takes ~10–20s)
        </div>
        <div id="suggestions"></div>
        <form method="post" action="/api/topics/create" id="topicForm">
          <div class="mb-2">
            <label class="form-label small">Slug</label>
            <input class="form-control mono" name="slug" id="f_slug" pattern="[a-z0-9-]+" placeholder="monsoon-battery-care" required />
          </div>
          <div class="mb-2">
            <label class="form-label small">English title</label>
            <input class="form-control" name="title_en" id="f_title_en" required />
          </div>
          <div class="mb-2">
            <label class="form-label small">Hindi title</label>
            <input class="form-control" name="title_hi" id="f_title_hi" required />
          </div>
          <div class="mb-2">
            <label class="form-label small">Category</label>
            <select class="form-select" name="category" id="f_category" required>
              <option value="" disabled selected>— Select category —</option>
              {categories.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div class="mb-2">
            <label class="form-label small">Editorial angle</label>
            <textarea class="form-control" name="angle" id="f_angle" rows="3"
              placeholder="Be specific: audience + the one question the article answers."></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label small">Hero image scene</label>
            <textarea class="form-control" name="image_prompt" id="f_image_prompt" rows="2"
              placeholder="Per-topic scene only — vehicle & style rules are enforced by the engine."></textarea>
          </div>
          <button class="btn btn-accent w-100" type="submit">＋ Queue Topic</button>
        </form>
        <div class="small text-secondary mt-2">
          💡 Suggest Topics checks Google Trends (India) + your existing content, then fills the form
          — or write your own. Same engine gates as the weekly cron; output lands as a <b>draft</b> for review.
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h6 fw-bold mb-0">Topics</h2>
          <a class="btn btn-sm btn-outline-light-subtle" href={ghUrl} target="_blank" rel="noopener">View Actions runs 🡕</a>
        </div>
        {topics.length === 0 ? (
          <p class="text-secondary small mb-0">No topics yet — queue one on the left.</p>
        ) : (
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
              <thead><tr><th>Topic</th><th>Lang</th><th>Status</th><th>Outcome</th><th class="text-end">Action</th></tr></thead>
              <tbody>
                {topics.map((t) => (
                  <tr>
                    <td>
                      <div class="fw-semibold small">{t.title}</div>
                      <div class="mono text-secondary">{t.slug}</div>
                    </td>
                    <td><span class={`badge lang-${t.lang}`}>{t.lang.toUpperCase()}</span></td>
                    <td><span class={`badge status-${t.status}`}>{t.status}</span></td>
                    <td class="small text-secondary">
                      {t.status === 'skipped-dup' && `dup of ${(t.outcome as any).dedupMatch}`}
                      {t.status === 'killed-commodity' && `${(t.outcome as any).killReason ?? ''}`.slice(0, 60)}
                      {t.status === 'halted-factcheck' && 'critical fact-check issue'}
                    </td>
                    <td class="text-end text-nowrap">
                      {t.status === 'pending' && (
                        <form method="post" action="/api/topics/draft" style="display:inline" class="draft-form">
                          <input type="hidden" name="slug" value={t.slug} />
                          <input type="hidden" name="lang" value={t.lang} />
                          <input type="hidden" name="provider" value={activeProvider} />
                          <button class="btn btn-sm btn-accent" type="submit" disabled={!llmReady}
                            title={llmReady ? 'Generate the article now with the selected model' : 'Add an LLM key in Settings'}
                            onclick="this.textContent='Writing… ~30s'; ">⚡ Draft with AI</button>
                        </form>
                      )}
                      {t.status === 'pending' && t.lang === 'en' && engineReady && (
                        <form method="post" action="/api/topics/dispatch" style="display:inline" class="ms-1">
                          <input type="hidden" name="slug" value={t.slug} />
                          <button class="btn btn-sm btn-outline-light-subtle" type="submit"
                            title="Full pipeline in GitHub Actions: all gates + hero images, EN+HI"
                            onclick="return confirm('Run the full engine for this topic (EN + HI)?')">▶ Engine</button>
                        </form>
                      )}
                      {t.status === 'drafted' && t.article_id && (
                        <a class="btn btn-sm btn-success" href={`/blog/${t.article_id}`}>Review draft</a>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <div class="small text-secondary mt-2">
          A run takes a few minutes (two model passes + two hero images). Refresh this page to see
          status move from <b>pending</b> → <b>drafted</b>.
        </div>
      </div>
    </div>
  </div>

  <script>
    const btn = document.getElementById('suggestBtn');
    const status = document.getElementById('suggestStatus');
    const box = document.getElementById('suggestions');

    btn?.addEventListener('click', async () => {
      btn.setAttribute('disabled', 'true');
      status.classList.remove('d-none');
      box.innerHTML = '';
      try {
        const provider = document.getElementById('f_provider')?.value;
        const res = await fetch('/api/topics/suggest', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ provider }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'suggestion failed');

        box.innerHTML = data.suggestions.map((s, i) => `
          <div class="card p-2 mb-2" style="background:#0e131d">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div>
                <div class="fw-semibold small">${esc(s.title_en)}</div>
                <div class="small"><span class="badge status-pending">${esc(s.category)}</span>
                  <span class="text-secondary">${esc(s.why)}</span></div>
              </div>
              <button class="btn btn-sm btn-accent flex-shrink-0" data-i="${i}">Use This →</button>
            </div>
          </div>`).join('') +
          `<div class="small text-secondary mb-2">Click "Use This" to fill the form, review, then Queue.</div>`;

        box.querySelectorAll('button[data-i]').forEach((b) => {
          b.addEventListener('click', () => {
            const s = data.suggestions[Number(b.dataset.i)];
            for (const [id, val] of [
              ['f_slug', s.slug], ['f_title_en', s.title_en], ['f_title_hi', s.title_hi],
              ['f_category', s.category], ['f_angle', s.angle], ['f_image_prompt', s.image_prompt],
            ]) document.getElementById(id).value = val;
            document.getElementById('f_slug').scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
        });
      } catch (e) {
        box.innerHTML = `<div class="alert alert-danger py-2 small">${esc(e.message)}</div>`;
      } finally {
        btn.removeAttribute('disabled');
        status.classList.add('d-none');
      }
    });

    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    }

    // Keep every "Draft with AI" form in sync with the model dropdown.
    const providerSel = document.getElementById('f_provider');
    providerSel?.addEventListener('change', () => {
      document.querySelectorAll('.draft-form input[name="provider"]')
        .forEach((i) => { i.value = providerSel.value; });
    });
  </script>
</AdminLayout>
