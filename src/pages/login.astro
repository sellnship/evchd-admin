---
import 'bootstrap/dist/css/bootstrap.min.css';
import '../styles/admin.css';

const err = Astro.url.searchParams.get('err');
---
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sign in — EVChd Admin</title>
  </head>
  <body>
    <div class="login-wrap">
      <div class="card login-card p-4">
        <div class="text-center mb-3">
          <div style="font-size:2rem; color:var(--accent)">⚡</div>
          <h1 class="h5 fw-bold mb-0">EVChd Admin</h1>
          <div class="text-secondary small">Sign in to manage the blog</div>
        </div>
        {err && <div class="alert alert-danger py-2 small">Wrong email or password.</div>}
        <form method="post" action="/admin/api/login">
          <div class="mb-3">
            <label class="form-label small">Email</label>
            <input class="form-control" type="email" name="email" required autocomplete="username" />
          </div>
          <div class="mb-3">
            <label class="form-label small">Password</label>
            <input class="form-control" type="password" name="password" required autocomplete="current-password" />
          </div>
          <button class="btn btn-accent w-100" type="submit">Sign in</button>
        </form>
      </div>
    </div>
  </body>
</html>
